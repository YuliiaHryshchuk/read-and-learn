{
  "name": "study-reader-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "pnpm db:migrate:local && wrangler pages dev --ip 0.0.0.0 --port 3000 --proxy 3001 -- pnpm next dev --webpack --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "preview:pages": "wrangler pages dev out --port 3000",
    "start": "next start",
    "lint": "eslint",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:local": "wrangler d1 migrations list DB --local"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sass": "^1.104.1",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  },
  "packageManager": "pnpm@12.4.2"
}
