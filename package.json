{
  "name": "read-and-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:next:docker": "next dev --webpack --hostname 0.0.0.0 --port 3001",
    "dev:pages:docker": "pnpm db:migrate:local && wrangler pages dev public --ip 0.0.0.0 --port 8788",
    "build": "next build",
    "preview:pages": "pnpm build && wrangler pages dev out --port 3000",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:puter": "vitest run --config vitest.puter.config.mts --passWithNoTests",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:local": "wrangler d1 migrations list DB --local"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.1",
    "sass": "^1.104.1",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.141.0"
  },
  "packageManager": "pnpm@12.4.2"
}
